<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zakatify - Manajemen Zakat Bisnis & Personal</title>
  
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#059669">

  <!-- CDN Dependencies -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/moment-hijri@2.1.2/moment-hijri.min.js"></script>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    body { background-color: #f1f5f9; color: #1e293b; padding: 16px; display: flex; justify-content: center; align-items: flex-start; min-height: 100vh; }
    .container { width: 100%; max-width: 500px; background: #ffffff; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); overflow: hidden; border: 1px solid #e2e8f0; }
    
    .header { background-color: #059669; color: white; padding: 24px; text-align: center; position: relative; }
    .header h1 { font-size: 26px; font-weight: 800; letter-spacing: -0.5px; }
    .header p { font-size: 13px; color: #d1fae5; margin-top: 4px; }
    
    .dev-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(0, 0, 0, 0.15);
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      color: #ecfdf5;
      margin-top: 10px;
      font-weight: 500;
    }
    .pulsing-dot {
      width: 8px;
      height: 8px;
      background-color: #34d399;
      border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.7);
      animation: pulse-animation 1.5s infinite;
    }
    @keyframes pulse-animation {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
    }

    .btn-install { display: none; margin: 12px auto 0 auto; background: #ffffff; color: #047857; border: none; padding: 8px 16px; border-radius: 20px; font-size: 12px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    .btn-install.show { display: inline-block; }

    .content { padding: 20px; display: flex; flex-direction: column; gap: 16px; }
    
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    label { font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
    select, input { width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none; background: #f8fafc; color: #1e293b; }
    select:focus, input:focus { border-color: #059669; background: #fff; box-shadow: 0 0 0 3px rgba(5,150,105,0.1); }

    .box-haul { background: #ecfdf5; border: 1px solid #a7f3d0; padding: 12px; border-radius: 10px; display: flex; flex-direction: column; gap: 6px; }
    .box-haul h2 { font-size: 13px; font-weight: 700; color: #065f46; }
    .haul-info { background: #ffffff; border: 1px solid #d1fae5; padding: 10px; border-radius: 8px; font-size: 12px; color: #334155; display: none; }
    .haul-info.show { display: block; }
    .haul-info p span { font-weight: bold; color: #047857; }
    .haul-info p .text-amber { color: #d97706; }

    .badge-mode { font-size: 10px; background: #d1fae5; color: #065f46; padding: 2px 8px; border-radius: 12px; font-weight: 600; float: right; }

    .result-box { background: #0f172a; color: #ffffff; padding: 16px; border-radius: 12px; display: flex; flex-direction: column; gap: 10px; }
    .result-row { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #94a3b8; }
    .result-row span.val { font-weight: 600; color: #f1f5f9; }
    hr { border: none; border-top: 1px solid #1e293b; margin: 4px 0; }
    .zakat-total { display: flex; justify-content: space-between; align-items: center; }
    .zakat-total .label-zakat { font-size: 12px; font-weight: bold; color: #34d399; }
    .zakat-total .status-desc { font-size: 10px; color: #94a3b8; }
    .zakat-total .nominal { font-size: 22px; font-weight: 800; color: #34d399; }

    .btn-save { width: 100%; background: #059669; color: white; border: none; padding: 12px; border-radius: 10px; font-weight: bold; font-size: 14px; cursor: pointer; transition: background 0.2s; }
    .btn-save:hover { background: #047857; }
  </style>
</head>
<body>

  <div class="container">
    <div class="header">
      <h1>Zakatify</h1>
      <p>Manajemen Zakat Bisnis & Personal Tanpa Ribet</p>
      
      <div class="dev-badge">
        <div class="pulsing-dot"></div>
        <span>Developer : fatur62</span>
      </div>

      <button id="btnInstall" class="btn-install">📲 Instal Aplikasi Zakatify</button>
    </div>

    <div class="content">
      <div class="form-group">
        <label>Pilih Profil Kamu:</label>
        <select id="tipeProfil" onchange="switchProfil()">
          <option value="umkm">🏪 Pebisnis / UMKM / Trader (Aset Dagang & Putaran)</option>
          <option value="karyawan">💼 Karyawan / PNS / Profesional (Gaji & Tabungan)</option>
        </select>
      </div>

      <div class="box-haul">
        <h2>📅 Penentuan Haul Zakat (1 Tahun Hijriyah)</h2>
        <div class="form-group">
          <label style="color: #047857;">Kapan Tabungan/Aset Pertama Kali Mencapai Nishab? (Masehi)</label>
          <input type="date" id="tglMasehi" onchange="hitungHaul()">
        </div>
        
        <div id="boxHaulInfo" class="haul-info">
          <p>Setara Tanggal Hijriyah: <span id="infoHijriah">-</span></p>
          <p>Jatuh Tempo Haul Berikutnya: <span id="infoJatuhTempo" class="text-amber">-</span></p>
          <p style="font-size: 9px; color: #94a3b8; margin-top: 4px; font-style: italic;">*Sistem otomatis menyesuaikan siklus 354 hari (Kalender Hijriyah).</p>
        </div>
      </div>

      <div>
        <div style="margin-bottom: 8px;">
          <label>Pencatatan Rincian Aset</label>
          <span id="badgeProfil" class="badge-mode">Mode UMKM</span>
        </div>
        <div id="formContainer" style="display: flex; flex-direction: column; gap: 10px;">
          <!-- Default Form Langsung Ada (Bukan Kosong) -->
          <div class="form-group"><label>Uang Tunai Kas Bisnis & Tabungan Usaha (Rp)</label><input type="number" id="field1" oninput="hitungZakat()" placeholder="0"></div>
          <div class="form-group"><label>Nilai Modal Stok Barang Dagangan (Rp)</label><input type="number" id="field2" oninput="hitungZakat()" placeholder="0"></div>
          <div class="form-group"><label>Piutang Lancar (Tagihan ke Pembeli) (Rp)</label><input type="number" id="field3" oninput="hitungZakat()" placeholder="0"></div>
          <div class="form-group"><label>Utang Usaha / Tagihan Supplier (Pemotong) (Rp)</label><input type="number" id="utang" oninput="hitungZakat()" placeholder="0"></div>
        </div>
      </div>

      <div class="result-box">
        <div class="result-row">
          <span>Estimasi Nishab (±85g Emas)</span>
          <span class="val" id="infoNishab">Rp 85.000.000</span>
        </div>
        <div class="result-row">
          <span>Total Aset Bersih:</span>
          <span class="val" id="totalAset" style="font-size: 14px;">Rp 0</span>
        </div>
        <hr>
        <div class="zakat-total">
          <div>
            <div class="label-zakat">Wajib Zakat Mal (2.5%):</div>
            <div id="statusNishab" class="status-desc">Belum mencapai nishab</div>
          </div>
          <div id="totalZakat" class="nominal">Rp 0</div>
        </div>
      </div>

      <button onclick="simpanKeSupabase()" class="btn-save">💾 Simpan Catatan Zakat</button>
    </div>
  </div>

  <script>
    const HARGA_EMAS_PER_GRAM = 1000000; 
    const NISHAB_RUPIAH = 85 * HARGA_EMAS_PER_GRAM;

    function switchProfil() {
      const profil = document.getElementById('tipeProfil').value;
      const container = document.getElementById('formContainer');
      const badge = document.getElementById('badgeProfil');

      if (profil === 'karyawan') {
        badge.innerText = 'Mode Karyawan / PNS';
        container.innerHTML = `
          <div class="form-group"><label>Total Tabungan & E-Wallet (Rp)</label><input type="number" id="field1" oninput="hitungZakat()" placeholder="0"></div>
          <div class="form-group"><label>Investasi (Reksadana, Saham, Deposito) (Rp)</label><input type="number" id="field2" oninput="hitungZakat()" placeholder="0"></div>
          <div class="form-group"><label>Emas Batangan / Logam Mulia (Nilai Rp)</label><input type="number" id="field3" oninput="hitungZakat()" placeholder="0"></div>
          <div class="form-group"><label>Utang/Cicilan Jatuh Tempo Bulan Ini (Pemotong) (Rp)</label><input type="number" id="utang" oninput="hitungZakat()" placeholder="0"></div>
        `;
      } else {
        badge.innerText = 'Mode UMKM / Bisnis';
        container.innerHTML = `
          <div class="form-group"><label>Uang Tunai Kas Bisnis & Tabungan Usaha (Rp)</label><input type="number" id="field1" oninput="hitungZakat()" placeholder="0"></div>
          <div class="form-group"><label>Nilai Modal Stok Barang Dagangan (Rp)</label><input type="number" id="field2" oninput="hitungZakat()" placeholder="0"></div>
          <div class="form-group"><label>Piutang Lancar (Tagihan ke Pembeli) (Rp)</label><input type="number" id="field3" oninput="hitungZakat()" placeholder="0"></div>
          <div class="form-group"><label>Utang Usaha / Tagihan Supplier (Pemotong) (Rp)</label><input type="number" id="utang" oninput="hitungZakat()" placeholder="0"></div>
        `;
      }
      hitungZakat();
    }

    function hitungHaul() {
      const inputDate = document.getElementById('tglMasehi').value;
      const boxInfo = document.getElementById('boxHaulInfo');
      
      if (!inputDate) {
        boxInfo.classList.remove('show');
        return;
      }

      boxInfo.classList.add('show');

      try {
        if (typeof moment !== 'undefined') {
          const m = moment(inputDate, 'YYYY-MM-DD');
          document.getElementById('infoHijriah').innerText = `${m.format('iD iMMMM iYYYY')} H`;
          const nextHaul = moment(inputDate, 'YYYY-MM-DD').add(354, 'days');
          document.getElementById('infoJatuhTempo').innerText = nextHaul.format('DD MMMM YYYY');
        } else {
          // Fallback tanpa library moment
          const d = new Date(inputDate);
          d.setDate(d.getDate() + 354);
          document.getElementById('infoHijriah').innerText = "Terhitung otomatis (+354 hari)";
          document.getElementById('infoJatuhTempo').innerText = d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
        }
      } catch (err) {
        console.log(err);
      }
    }

    function hitungZakat() {
      const f1 = Number(document.getElementById('field1')?.value) || 0;
      const f2 = Number(document.getElementById('field2')?.value) || 0;
      const f3 = Number(document.getElementById('field3')?.value) || 0;
      const utang = Number(document.getElementById('utang')?.value) || 0;

      const totalAsetBersih = (f1 + f2 + f3) - utang;
      let zakatWajib = 0;
      const statusEl = document.getElementById('statusNishab');

      if (totalAsetBersih >= NISHAB_RUPIAH) {
        zakatWajib = totalAsetBersih * 0.025;
        statusEl.innerText = '✅ Aset memenuhi syarat Nishab';
        statusEl.style.color = '#34d399';
      } else {
        zakatWajib = 0;
        statusEl.innerText = '❌ Belum mencapai batas minimum Nishab';
        statusEl.style.color = '#94a3b8';
      }

      document.getElementById('totalAset').innerText = 'Rp ' + totalAsetBersih.toLocaleString('id-ID');
      document.getElementById('totalZakat').innerText = 'Rp ' + zakatWajib.toLocaleString('id-ID');
    }

    function simpanKeSupabase() {
      alert('Data zakat berhasil dihitung!');
    }

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('sw.js').catch(e => console.log(e));
    }
  </script>
</body>
</html>
